  "item": [
    {
      "name": "1. GET 404 — first (MISS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is image/jpeg', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('image/jpeg');",
              "});",
              "pm.test('X-Cache is MISS', () => {",
              "  pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
